{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "spike",
  "description": "M2 spike capability — PTY harness only. Enables spike commands over Channel when spike feature is active. Also includes M3 terminal commands for spike WebView harness reusing production manager.",
  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-terminal-profiles",
    "allow-terminal-start",
    "allow-terminal-list",
    "allow-terminal-attach",
    "allow-terminal-detach",
    "allow-terminal-hide",
    "allow-terminal-show",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-close",
    "allow-terminal-restart",
    "allow-terminal-poll",
    "allow-terminal-replay",
    "allow-spike-pty-stream",
    "allow-spike-resize",
    "allow-spike-input-echo",
    "allow-spike-completion"
  ]
}
