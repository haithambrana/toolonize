{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only, local content only. Exactly the ToolOnize command inventory (commands::ALLOWED_COMMANDS); no shell, filesystem, http, process, opener, dialog, or remote capabilities. Execution is reachable only via session_start/member_launch, which name a workspace member checked by the Rust execution policy.",
  "windows": ["main"],
  "permissions": [
    "allow-ping",
    "allow-app-startup-info",
    "allow-events-subscribe",
    "allow-settings-get",
    "allow-settings-update",
    "allow-audit-recent",
    "allow-open-url",
    "allow-clipboard-read-text",
    "allow-scrollback-export",
    "allow-registry-view",
    "allow-registry-rescan",
    "allow-registry-set-hidden",
    "allow-registry-set-alias",
    "allow-registry-approve",
    "allow-registry-revoke",
    "allow-registry-acknowledge",
    "allow-custom-root-add",
    "allow-custom-root-remove",
    "allow-synthetic-add",
    "allow-synthetic-remove",
    "allow-ssh-hosts",
    "allow-workspace-list",
    "allow-workspace-create",
    "allow-workspace-rename",
    "allow-workspace-set-color",
    "allow-workspace-delete",
    "allow-workspace-set-active",
    "allow-workspace-set-policy",
    "allow-workspace-accept-import",
    "allow-workspace-save-layout",
    "allow-workspace-open",
    "allow-workspace-export",
    "allow-workspace-import",
    "allow-member-add",
    "allow-member-remove",
    "allow-member-update",
    "allow-member-authorize",
    "allow-member-launch",
    "allow-session-start",
    "allow-session-write",
    "allow-session-resize",
    "allow-session-attach",
    "allow-session-detach",
    "allow-session-ack",
    "allow-session-view",
    "allow-session-stop",
    "allow-session-restart",
    "allow-session-reconnect",
    "allow-session-cancel-reconnect",
    "allow-session-close",
    "allow-session-list"
  ]
}
